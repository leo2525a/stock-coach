import { readFileSync } from 'node:fs';
import { parseDividendEvents, assembleDividends, buildSchedule, upcomingRow, parseDividendFacts } from '../../shared/dividends';
const OUT = 'review-evidence/recon-phase4/out/';
const read = (f: string) => JSON.parse(readFileSync(OUT + f, 'utf8'));
const iso = (t: number|null) => t===null?'—':new Date(t*1000).toISOString().slice(0,10);
const divMap = read('div-O-max.json');
const chartJson = { chart: { result: [{ meta: { currency: 'USD' }, events: { dividends: divMap } }] } };
const rawEvents = parseDividendEvents(chartJson);
console.log('raw last 4 chart events:', rawEvents.slice(-4).map(e=>`${iso(e.date)}=${e.amount}`).join(' '));
const factsJson = { quoteSummary: { result: [{ price:{currency:'USD'}, summaryDetail:{ dividendRate:{raw:1.088}, exDividendDate:{raw:1793318400} }, defaultKeyStatistics:{lastDividendValue:{raw:0.272}}, calendarEvents:{dividendDate:{raw:1794528000}} }], error:null } };
const facts = parseDividendFacts(factsJson, 100, rawEvents.map(e=>e.date));
const next = upcomingRow(facts, facts.frequency.value);
console.log('upcomingRow ->', next && { ex: iso(next.exDate), pay: iso(next.payableDate), amount: next.amount });
console.log('frequency ->', JSON.stringify(facts.frequency));
const rows = buildSchedule(rawEvents, 'USD', facts.frequency.value, null);
console.log('buildSchedule rows at 2026-10-30 ->', rows.filter(r=>iso(r.exDate)==='2026-10-30').length);
const p = assembleDividends({ symbol:'O', price:100, factsJson, chartJson, yieldJson:{}, shareholder:{dividendsPaid:null,repurchaseOfStock:null,longTermDebtPayments:null,longTermDebtIssuance:null,sharesAtFyEnd:null,priceAtFyEnd:null,asOf:''}, source:'live', lastUpdated:'', note:null, now:1793980336 } as never);
console.log('final rows at 2026-10-30 ->', p.events.filter(r=>iso(r.exDate)==='2026-10-30').map(r=>`amt=${r.amount} pay=${iso(r.payableDate)}`));
console.log('final last 3 rows ->', p.events.slice(-3).map(r=>`${iso(r.exDate)}=${r.amount}/pay=${iso(r.payableDate)}`));
