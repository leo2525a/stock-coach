{
  "name": "stock-coach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Stock Coach - a beginner-first stock analysis PWA (multi-timeframe candles, rule-based indicator signals).",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "evidence:chart": "node scripts/evidence-chart.mjs",
    "evidence:colour": "node scripts/evidence-colour.mjs",
    "evidence:phase3": "node scripts/evidence-phase3.mjs",
    "evidence:phase4": "node scripts/evidence-phase4.mjs",
    "evidence:phase5": "node scripts/evidence-phase5.mjs",
    "ios:build": "xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination \"platform=iOS Simulator,name=iPhone 17\" -derivedDataPath build/ios build",
    "ios:run": "xcrun simctl boot \"iPhone 17\" 2>/dev/null; open \"/Applications/Xcode.app/Contents/Applications/DeviceHub.app\"; xcrun simctl install booted build/ios/Build/Products/Debug-iphonesimulator/App.app && xcrun simctl launch booted com.stockcoach.app",
    "lint": "eslint .",
    "native:add": "npx cap add ios",
    "native:open": "npx cap open ios",
    "native:build": "VITE_API_BASE=\"http://127.0.0.1:8787/api\" vite build --base=./ --outDir dist-native --emptyOutDir",
    "native:sync": "npm run native:build && npx cap sync ios",
    "preview": "vite preview --port 4173",
    "server": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:runtime": "tsx scripts/verify-runtime.ts"
  },
  "dependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@types/express": "^5.0.6",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "technicalindicators": "^3.1.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
