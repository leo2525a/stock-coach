import { readFileSync } from 'node:fs';
import { openDb } from '../../server/db';
import { loadEstimates, loadStatements } from '../../server/phase3-service';
const F='tests/fixtures';
const q=JSON.parse(readFileSync(`${F}/timeseries-AAPL-quarterly.json`,'utf8'));
const a=JSON.parse(readFileSync(`${F}/timeseries-AAPL-annual.json`,'utf8'));
const qs=JSON.parse(readFileSync(`${F}/quotesummary-AAPL.json`,'utf8'));
const chart={chart:{result:[{meta:{symbol:'AAPL',currency:'USD',regularMarketPrice:200,longName:'Apple Inc.'},timestamp:[1790000000,1790086400],indicators:{quote:[{open:[199,200],high:[201,202],low:[198,199],close:[200,201],volume:[1e6,1.1e6]}]}}]}};
const fetchImpl=(async (input:any)=>{
  const url=typeof input==='string'?input:input.toString();
  if(url.includes('/v1/test/getcrumb')) return new Response('c',{status:200,headers:{'set-cookie':'A3=c; Path=/'}});
  if(url.includes('fc.yahoo.com')) return new Response('',{status:200,headers:{'set-cookie':'A1=p; Path=/'}});
  if(url.includes('fundamentals-timeseries')) return new Response(JSON.stringify(url.includes('quarterly')?q:a),{status:200});
  if(url.includes('/v10/finance/quoteSummary/')) return new Response(JSON.stringify(qs),{status:200});
  if(url.includes('/v8/finance/chart/')) return new Response(JSON.stringify(chart),{status:200});
  return new Response('nf',{status:404});
}) as unknown as typeof fetch;
const db=openDb(':memory:');
const st=await loadStatements(db,'AAPL','quarterly',{fetchImpl,now:1800000000});
console.log('quarterly income columns:',st.income.columns);
console.log('quarterly inputs:',JSON.stringify(st.inputs,null,1));
const est=await loadEstimates(db,'AAPL',{fetchImpl,now:1800000000});
console.log('MATRIX:',JSON.stringify(est.matrix,null,1));
console.log('FORWARD:',JSON.stringify(est.forward));
console.log('periods endDates:',est.periods.map(p=>`${p.id}=${p.endDate} eps=${p.eps.avg} rev=${p.revenue.avg}`).join(' | '));
