node_modules/
dist/
dev-dist/
coverage/
*.log
.cache/
# Runtime data (SQLite cache/db + WAL side files)
data/*.db
data/*.db-shm
data/*.db-wal
# Generated evidence is kept, but keep the raw DOM dumps out of git noise
evidence/*.html
!evidence/.gitkeep

# Heavy generated evidence artifacts (screenshots / DOM dumps / traces). The
# harness scripts and their JSON reports are tracked; images are regenerated by
# the evidence gates and are not worth carrying in git.
evidence/**/*.png
evidence/**/*.jpg
evidence/**/*.webm
review-evidence/**/*.png
review-evidence/**/*.jpg
review-evidence/**/*.webm
followup-evidence/**/*.png
review-evidence/**/scratch/

# Native (Capacitor) build output
dist-ios/
ios/App/App/public/
ios/App/Pods/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/

# Scratch databases and temp dirs produced by the evidence harnesses
**/*.db
**/*.db-shm
**/*.db-wal
evidence/.work*/
review-evidence/**/.work*/
review-evidence/**/tmp/
review-evidence/**/out/
followup-evidence/**/*.db

# Scratch probe output
tmp/
